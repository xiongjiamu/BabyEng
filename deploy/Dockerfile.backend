# BabyEng Rust 后端镜像（多阶段构建 → distroless，PRD 9.9）
FROM rust:1.82-alpine AS build
RUN apk add --no-cache musl-dev sqlite-dev
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock* ./
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && cargo build --release || true
COPY backend/ .
RUN cargo build --release

# 运行镜像：debian-slim（需 ffmpeg 转码；distroless 无 ffmpeg，改用 slim）
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/release/babyeng-backend /usr/local/bin/babyeng
COPY data/seed /app/data/seed
EXPOSE 8080
CMD ["babyeng"]
